---
// The waitlist form as static HTML, shown until the WaitlistForm island hydrates. Submitting needs
// the island, so the button stays disabled here (a no-JS submit would put the email in the URL).
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<form class="waitlist-form">
  <label class="visually-hidden" for={`${id}-email`}>Email address</label>
  <input
    class="waitlist-input"
    id={`${id}-email`}
    type="email"
    placeholder="you@example.com"
    required
    autocomplete="email"
  />
  <button class="m3e-button m3e-button--size-m" type="submit" disabled>Get notified</button>
</form>
<div class="form-status" role="status" aria-live="polite"></div>
