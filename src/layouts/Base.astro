---
import { createTheme } from '@kyralabs/m3e-tokens/theme';
// The latin chunk of Google Sans Flex (fonts.css), preloaded as the old site preloaded its font.
import fontLatin from '@kyralabs/m3e-tokens/fonts/google-sans-flex-latin.woff2?url';
import { brand } from '../brand.mjs';
import NavFallback from '../components/NavFallback.astro';
import SectionNav from '../islands/SectionNav';
import type { NavLink } from '../nav';
import '../styles/site.css';

interface Props {
  title: string;
  nav: readonly NavLink[];
  /** The full footer (home page) or only its bottom row (privacy page), as before. */
  fullFooter: boolean;
}

const { title, nav, fullFooter } = Astro.props;
// Browser UI colour in dark mode: the generated dark surface (the light value is the site's
// original theme-color, kept as is).
const darkSurface = createTheme({ ...brand, mode: 'dark' }).tokens.dark?.surface;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <slot name="head" />
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={darkSurface} />
    <meta name="theme-color" content="oklch(97% 0.012 35)" />
    <slot name="meta" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Kyra Labs" />
    <link rel="manifest" href="/site.webmanifest" />
    <slot name="structured-data" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="m3e-top-app-bar site-bar">
      <div class="m3e-top-app-bar__headline site-bar__headline">
        <a class="back-to-studio" href="https://kyralabs.dev/">
          <img src="/assets/img/kyra-wordmark.png" alt="" width="67" height="36" />
          <span>Kyra Labs</span>
        </a>
      </div>
      <nav class="m3e-top-app-bar__actions site-bar__links" aria-label="Primary">
        {
          nav.map((item) => (
            <a
              class:list={[
                'm3e-button',
                item.isPrimary ? 'm3e-button--size-s' : 'm3e-button--text m3e-button--size-s',
              ]}
              href={item.href}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <SectionNav client:only="react" items={nav}>
      <NavFallback slot="fallback" items={nav} />
    </SectionNav>

    <slot />

    <footer class="site-footer">
      <hr class="m3e-divider" />
      {
        fullFooter && (
          <div class="footer-top">
            <div class="footer-brand">
              <img src="/assets/img/kyra-wordmark.png" alt="Kyra Labs" width="104" height="56" />
              <p>
                Spenzia is built and maintained by Kyra Labs, an independent one-person app studio.
              </p>
            </div>
            <div class="footer-col">
              <h2>Spenzia</h2>
              <a href="#features">Features</a>
              <a href="#built-by">About</a>
              <a href="#waitlist">Get notified</a>
            </div>
            <div class="footer-col">
              <h2>Connect</h2>
              <a href="https://kyralabs.dev/">Kyra Labs</a>
              <a href="https://www.instagram.com/kyra__labs/" target="_blank" rel="noopener">
                Instagram
              </a>
              <a href="https://github.com/kyra-labs" target="_blank" rel="noopener">
                GitHub
              </a>
              <a href="mailto:contact@kyralabs.dev">Email</a>
            </div>
          </div>
        )
      }
      <div class="footer-bottom">
        <p>© 2026 Kyra Labs. Spenzia is under active development.</p>
        <a href="/privacy.html">Privacy Policy</a>
      </div>
    </footer>

    <!-- Deferred module (bundled by Astro): ripple + html.js for the scroll reveals. -->
    <script>
      import '../scripts/enhance';
    </script>
  </body>
</html>
